# Copy to .env and fill in. Never commit .env.

# ---- app ----
APP_ENV=development                 # development | test | production
# 32+ random characters in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=12
COOKIE_SECURE=false                 # true when served over HTTPS (production)
ALLOW_INSECURE_COOKIES=false        # true only for a plain-HTTP shop LAN (not recommended)
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_API_DOCS=true

# ---- GSP: e-way bills and IRN (Milestone 10) ----
GSP_PROVIDER=fake                   # fake (dev/test only) | sandbox | live
# GSP_BASE_URL=https://sandbox.example-gsp.in/api
# GSP_CLIENT_ID=
# GSP_CLIENT_SECRET=
# GSP_USERNAME=
# GSP_PASSWORD=
GSP_TIMEOUT_SECONDS=20

# ---- database (production compose builds DATABASE_URL from these) ----
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=erp
# DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp   # for running the API outside Docker

# ---- production extras ----
HTTP_PORT=80
BACKUP_KEEP_DAYS=30

# ---- first-run seed (production: set these, or random passwords are generated and printed) ----
SEED_SHOP_NAME=Demo Construction Materials
SEED_STATE_CODE=33
# SEED_OWNER_PASSWORD=
# SEED_COUNTER1_PASSWORD=
# SEED_COUNTER2_PASSWORD=
# SEED_ACCOUNTS_PASSWORD=
